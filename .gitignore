# deps
node_modules/

# build
dist/
build/
*.tsbuildinfo

# next
.next/
.next-dev-verify/
out/
# Next.js 生成文件：next dev 写 .next/dev/types 路径、next build 写 .next/types 路径，
# 本地交替跑两命令会无限漂移；两个 app 的 tsc 已实证不依赖它（缺失时 typecheck 照样过），
# dev/build 会自动再生，故不入库
next-env.d.ts

# env
.env
.env.local
.env.*.local

# logs
*.log
# 仅根级运行时日志目录；不锚定会误吞 App Router 路由目录
# apps/admin/src/app/(main)/dashboard/logs（CI 首跑 ENOENT 根因）
/logs/

# live-fire 套件运行时日志目录（栈进程 stdout 落盘；产物勿入库）
e2e/live-fire/logs/
# live-fire SMTP 捕获文件（smtp-sink 每次运行再生，含验证码邮件内容）
e2e/live-fire/.smtp-captures.ndjson

# docker
docker/data/
docker/nginx/certs/
docker/nginx/certs-server/

# redis 持久化数据（运行时产物，勿入库）
*.rdb
appendonlydir/
*.aof

# misc
.DS_Store
coverage/
.turbo/

# agent 工具产物
.zcode/

# 机器生成（generated/ 按文档约定决定是否入库；产物目录本身不受 git 追踪时取消注释）
# generated/api-client/
