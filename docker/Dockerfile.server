# syntax=docker/dockerfile:1
# 服务端统一镜像（gateway / worker / admin-api / client-api / trace-receiver），compose 通过 build arg APP 指定
# 构建段：全 bun（bun install + bun build）
# 运行段：bun 运行时（oven/bun 镜像，bun dist/index.js）
FROM oven/bun:1.4-alpine AS builder
ARG APP
WORKDIR /repo
COPY package.json bun.lock tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile
# 尾部 ... = 含依赖图（bun --filter 默认只跑本包；依赖包 dist 不构建则运行时解析必炸）
RUN bun run --filter "@ai-gateway/${APP}..." build \
  && mkdir -p /out \
  && cp -r "apps/${APP}/dist" /out/dist

FROM oven/bun:1.4-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out/dist ./dist
COPY --from=builder /repo/package.json ./package.json
COPY --from=builder /repo/packages ./packages
COPY --from=builder /repo/node_modules ./node_modules
CMD ["bun", "dist/index.js"]
