# migrate：一次性迁移任务（postgres 就绪后执行并退出）
# v2 迁移收敛为单入口：packages/db 的 drizzle-kit migrate（SQL 全量在 packages/db/migrations，
# 含 identity/billing 等业务表——v1 的 identity-core/ledger-core/wallet 多段 provision 已并入）
# 构建段：全 bun；运行段：bun 直跑 drizzle-kit CLI
FROM oven/bun:1.4.0-alpine AS builder
WORKDIR /repo
COPY package.json bun.lock tsconfig.base.json ./
# bun patch 依赖(patchedDependencies)——漏拷则 --frozen-lockfile 直接报找不到 patch 文件
COPY patches ./patches
# manifest 先行：bun install 的输入只有根 manifest/lockfile/patches + 各 workspace 成员的
# package.json——源码后拷，改源码不再打掉 install 层缓存。
# 新增 workspace 成员时须同步补一行（漏拷则 --frozen-lockfile 报 workspace 成员缺失）。
COPY packages/accounts/package.json packages/accounts/
COPY packages/ai/package.json packages/ai/
COPY packages/api-client/package.json packages/api-client/
COPY packages/billing/package.json packages/billing/
COPY packages/control-plane/package.json packages/control-plane/
COPY packages/db/package.json packages/db/
COPY packages/errors/package.json packages/errors/
COPY packages/http/package.json packages/http/
COPY packages/identity/package.json packages/identity/
COPY packages/inference/package.json packages/inference/
COPY packages/notifications/package.json packages/notifications/
COPY packages/observability/package.json packages/observability/
COPY packages/runtime/package.json packages/runtime/
COPY packages/ui/package.json packages/ui/
COPY apps/admin/package.json apps/admin/
COPY apps/admin-api/package.json apps/admin-api/
COPY apps/client/package.json apps/client/
COPY apps/client-api/package.json apps/client-api/
COPY apps/gateway/package.json apps/gateway/
COPY apps/trace-receiver/package.json apps/trace-receiver/
COPY apps/worker/package.json apps/worker/
# 缓存挂载：bun 下载缓存跨构建持久（与 Dockerfile.server 共享同一缓存卷）
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY packages ./packages
COPY apps ./apps

FROM oven/bun:1.4.0-alpine AS runtime
WORKDIR /repo
# node_modules 必拷：drizzle-kit 运行时解析 drizzle-orm 等（isolated linker 下 .bun store 与
# packages/*/node_modules 软链互相引用，node_modules + packages 必须整体拷贝；
# 与 Dockerfile.server 的「仅 dist」口径相反——本镜像一次性执行即退出，体积让位于零改造）
COPY --from=builder /repo/package.json ./package.json
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/packages ./packages
# apps 侧运维脚本（create-admin、存量凭据迁移等）随镜像分发——生产
# `docker compose --env-file .env run --rm --workdir /repo migrate bun --conditions=development apps/admin-api/scripts/create-admin.ts --email=you@example.com --apply`
# 直跑官方脚本，不再依赖宿主机 clone 仓库或挂载变通
COPY --from=builder /repo/apps ./apps
WORKDIR /repo/packages/db
# 空库两步初始化(provision-fresh.ts 头注释的正式收口):先前置幂等 DDL
# (迁移链 0055-0057 前向引用 0059/0076 才建的表,空库直跑 journal 必在 0055
# 失败——且 drizzle-kit 在 bun 下静默 exit 1 无错误输出),再走 journal 全量。
# --conditions=development:workspace 包 exports 非开发条件指向 dist/(本镜像不构建),
# 直跑 TS 源码脚本时必须显式启用 development 条件才解析到 src/。
# DATABASE_URL 由 compose environment 注入(provision-fresh 缺 env 时报错退出)
USER bun
CMD ["sh", "-c", "bun --conditions=development scripts/provision-fresh.ts && bun node_modules/.bin/drizzle-kit migrate"]
