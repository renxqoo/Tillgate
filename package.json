{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AI Gateway — 多供应商 LLM API 中转站（对外售卖）",
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo run dev --filter @ai-gateway/client",
    "dev:admin": "turbo run dev --filter @ai-gateway/admin",
    "dev:client-api": "turbo run dev --filter @ai-gateway/client-api",
    "dev:admin-api": "turbo run dev --filter @ai-gateway/admin-api",
    "dev:gateway": "turbo run dev --filter @ai-gateway/gateway",
    "dev:worker": "turbo run dev --filter @ai-gateway/worker",
    "dev:v1": "turbo run dev --filter @ai-gateway/console",
    "start:gateway": "node apps/gateway/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "start:admin-api": "node apps/admin-api/dist/index.js",
    "start:client-api": "node apps/client-api/dist/index.js",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:real": "pnpm --filter @ai-gateway/ai test:real",
    "lint": "turbo lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @ai-gateway/db db:generate",
    "db:migrate": "pnpm --filter @ai-gateway/db db:migrate",
    "db:studio": "pnpm --filter @ai-gateway/db db:studio",
    "docker:up": "docker compose -f docker/compose.yml up -d",
    "docker:up:obs": "docker compose -f docker/compose.yml --profile obs up -d"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "recharts": "3.10.1"
    }
  }
}
