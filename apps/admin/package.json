    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.0",
    "next-intl": "^4.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.8.0",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
