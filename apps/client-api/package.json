{
  "name": "@ai-gateway/client-api",
  "version": "0.1.0",
  "private": true,
  "description": "用户面板 REST（Hono，仅内网，不发布端口）——从 admin-api 拆分的用户面",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/identity": "workspace:*",
    "@ai-gateway/ledger": "workspace:*",
    "@ai-gateway/ledger-core": "workspace:*",
    "@ai-gateway/wallet": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
