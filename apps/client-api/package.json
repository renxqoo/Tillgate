{
  "name": "@tillgate/client-api",
  "version": "0.1.0",
  "private": true,
  "description": "用户控制台 REST API：会话/资料/Key/App/组织/钱包/兑换/支付/订阅/用量/定价/推荐——业务全部经能力包 facade，本 app 只保留协议与装配（P5）",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x --bun vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x --bun vitest run app.real.test.ts --passWithNoTests",
    "test:coverage": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@tillgate/accounts": "workspace:*",
    "@tillgate/billing": "workspace:*",
    "@tillgate/control-plane": "workspace:*",
    "@tillgate/db": "workspace:*",
    "@tillgate/errors": "workspace:*",
    "@tillgate/http": "workspace:*",
    "@tillgate/identity": "workspace:*",
    "@tillgate/observability": "workspace:*",
    "@tillgate/runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
