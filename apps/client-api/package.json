{
  "name": "@tokenlens/client-api",
  "version": "0.1.0",
  "private": true,
  "description": "用户控制台 REST API：会话/资料/Key/App/组织/钱包/兑换/支付/订阅/用量/定价/推荐——业务全部经能力包 facade，本 app 只保留协议与装配（P5）",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun --env-file-if-exists=../../.env x vitest run app.real.test.ts journey.real.test.ts --passWithNoTests",
    "test:coverage": "bun x vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tokenlens/accounts": "workspace:*",
    "@tokenlens/billing": "workspace:*",
    "@tokenlens/control-plane": "workspace:*",
    "@tokenlens/db": "workspace:*",
    "@tokenlens/errors": "workspace:*",
    "@tokenlens/http": "workspace:*",
    "@tokenlens/identity": "workspace:*",
    "@tokenlens/observability": "workspace:*",
    "@tokenlens/runtime": "workspace:*",
    "hono": "^4.13.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.0",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "pg": "^8.22.0",
    "@types/pg": "^8.15.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
