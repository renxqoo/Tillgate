{
  "name": "@ai-gateway/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ meter 队列消费编排（结算/对账领域逻辑在 @ai-gateway/ledger）",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-gateway/ai": "workspace:*",
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/identity": "workspace:*",
    "@ai-gateway/ledger": "workspace:*",
    "@ai-gateway/money": "workspace:*",
    "@ai-gateway/tracing": "workspace:*",
    "bullmq": "^6.0.7",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
