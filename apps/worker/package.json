{
  "name": "@ai-gateway/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ 消费者：计量结算 / 对账 / 清理任务",
  "main": "./src/index.ts",
  "scripts": {
