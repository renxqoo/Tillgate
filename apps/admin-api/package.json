{
  "name": "@ai-gateway/admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "管理面 app：管理员会话/2FA、供应商/渠道/模型绑定/费率卡（计费三轴）、模型目录——SQL 全部下沉 @ai-gateway/repository，账户域业务在本 app services",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --config ../../tsup.config.base.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-gateway/ai": "workspace:*",
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/domain": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/identity": "workspace:*",
    "@ai-gateway/identity-core": "workspace:*",
    "@ai-gateway/repository": "workspace:*",
    "@ai-gateway/service": "workspace:*",
    "@ai-gateway/tracing": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.8",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
