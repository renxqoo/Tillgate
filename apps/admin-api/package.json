{
  "name": "@ai-gateway/admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "管理端 REST（Hono，仅内网，不发布端口）",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-gateway/ai": "workspace:*",
    "@ai-gateway/billing": "workspace:*",
    "@ai-gateway/config": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/identity": "workspace:*",
    "@ai-gateway/logger": "workspace:*",
    "@ai-gateway/money": "workspace:*",
    "@ai-gateway/otel": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
