{
  "name": "@ai-gateway/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "对外代理：billing_requests 足额授权 + durable receipt，无状态可多副本",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-gateway/ai": "workspace:*",
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/ledger": "workspace:*",
    "@ai-gateway/wallet": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.9.0",
    "@opentelemetry/api": "^1.9.1",
    "bullmq": "^6.0.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
