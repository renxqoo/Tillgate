{
  "name": "@ai-gateway/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "纯网关 app：HTTP 适配 + 推理管线编排 + 装配根——业务全部来自 @ai-gateway/service",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --config ../../tsup.config.base.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@ai-gateway/ai": "workspace:*",
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/domain": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/repository": "workspace:*",
    "@ai-gateway/service": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "bullmq": "^6.0.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
