{
  "name": "@tillgate/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI/模型推理公网入口：协议适配 + 鉴权 + 限流 + 装配（重构方案 §3 目标树；推理编排/计价/渠道健康全部来自 @tillgate/inference）",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x --bun vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x --bun vitest run \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:coverage": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@tillgate/accounts": "workspace:*",
    "@tillgate/ai": "workspace:*",
    "@tillgate/billing": "workspace:*",
    "@tillgate/control-plane": "workspace:*",
    "@tillgate/db": "workspace:*",
    "@tillgate/errors": "workspace:*",
    "@tillgate/http": "workspace:*",
    "@tillgate/inference": "workspace:*",
    "@tillgate/observability": "workspace:*",
    "@tillgate/runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">= 1.4.0"
  }
}
