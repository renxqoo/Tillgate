# ──────────────────────────────────────────────────────────────
# 环境变量模板
# 用法：cp .env.example .env，然后填写真实值
# ──────────────────────────────────────────────────────────────
# ── 运行环境 ──
NODE_ENV=development
LOG_LEVEL=info
# ── PostgreSQL ──
# 格式：postgres://用户:密码@主机:端口/库名
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_gateway
# ── Redis ──
# REDIS_PASSWORD 用于 compose 的 redis --requirepass；REDIS_URL 须与此一致。
# 开发留空（compose 不启用 requirepass）；生产务必设强随机值。
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# ── 安全密钥（必填！留空或填占位符会启动失败）──
#
# 这两个密钥是系统安全的根基，必须用强随机值生成：
#   openssl rand -hex 32
#
# ⚠️ ENCRYPTION_KEY 特别注意：
#   - 用于加密 DB 中所有渠道的上游 API Key（AES-256-GCM）
#   - 轮换走「双 key 窗」：临时加 ENCRYPTION_KEY_OLD=<旧值> + ENCRYPTION_KEY=<新值> → 重启
#     → 跑 scripts/rotate-encryption-key.ts（事务化迁移 v1→v2，可并发可重跑）→ 完成后
#     移除 ENCRYPTION_KEY_OLD 再重启（收窗）。脚本头部有完整流程。
#   - 禁止使用 change-me / secret / password 等弱值（config 会拒绝启动）
#
# ⚠️ JWT_SECRET（用户面会话密钥，client-api 用）：
#   - 签发用户登录会话 Token（ag_session cookie，HS256，type='user'）
#   - 换了之后所有已登录用户需重新登录（无数据损失）
#   - 禁止使用弱值（config 会拒绝启动）
JWT_SECRET=
#
# ⚠️ ADMIN_JWT_SECRET（管理面会话密钥，admin-api 用，与 JWT_SECRET 物理隔离）：
#   - 签发管理员登录会话 Token（ag_admin_session cookie，HS256，type='admin'）
#   - 必须与 JWT_SECRET 不同值（隔离要求：用户面 bug 不波及管理员）
#   - 换了之后所有管理员需重新登录
#   - 禁止使用弱值（config 会拒绝启动）
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=
# ENCRYPTION_KEY_OLD=   # 仅轮换窗口期设置（v1 密文解密用），收窗后必须移除
# ── 渠道进货凭证截图存储（本地磁盘，后续可切 OSS） ──
VOUCHER_STORAGE_DIR=./data/vouchers
VOUCHER_MAX_BYTES=2097152
# ── 企业计费授权与 lease ──
BILLING_RESERVATION_MAX=50
BILLING_PENDING_MAX=10000
BILLING_PENDING_MAX_AGE_SECONDS=300
BILLING_ADMISSION_CACHE_MS=1000
BILLING_AUTHORIZATION_TTL_SECONDS=60
BILLING_LEASE_SECONDS=60
GATEWAY_REQUEST_DEADLINE_MS=240000
GATEWAY_MAX_CONNECTIONS=10000
GATEWAY_HEADERS_TIMEOUT_MS=10000
GATEWAY_REQUEST_TIMEOUT_MS=300000
# 优雅停机宽限（毫秒）：停机即拒新请求；宽限结束前 5s 中止在途请求（服务端责任释放）
GATEWAY_SHUTDOWN_GRACE_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# ── 新用户默认限流 ──
DEFAULT_USER_RPM=60
DEFAULT_USER_TPM=1000000
# ── worker 计量结算并发数 ──
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=8792
# 可信反向代理层数（XFF 信任模型）：0=完全不信任 XFF（直连部署，防伪造默认值）；
# nginx 单层反向代理部署必须设 1（取 XFF 右数第 1 跳=真实客户端 IP，伪造首段被丢弃）
TRUSTED_PROXY_HOPS=0
# BFF 服务间令牌：配置后 Origin/Referer 双缺失的状态变更请求必须携带 x-internal-token
# （Next.js 服务端调用注入；浏览器无法获得）。生产必配；开发不配=兼容期放行
# INTERNAL_API_TOKEN=change-me-internal-api-token-32chars
# 深度健康报告 /health 的访问令牌（livez/readyz 无需令牌）；不设则 /health 一律 403
WORKER_HEALTH_TOKEN=change-me-worker-health-token-32chars
WORKER_CLAIM_BATCH_SIZE=100
WORKER_CLAIM_LEASE_MS=60000
WORKER_POLL_INTERVAL_MS=2000
WORKER_RECOVERY_INTERVAL_MS=30000
WORKER_RECOVERY_BATCH_SIZE=500

# ── OAuth 社交登录（可选；不配即关，前端按钮自动隐藏）────
# GitHub：Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL 填：{OAUTH_API_BASE}/api/auth/oauth/github/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# Google：Google Cloud Console → API 和服务 → 凭据 → 创建 OAuth 客户端 ID（Web 应用）
#   已获授权的重定向 URI 填：{OAUTH_API_BASE}/api/auth/oauth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# client-api 对外可达基地址（拼 redirect_uri，默认本机）
# OAUTH_API_BASE=http://localhost:8791
# OAuth 登录完成后重定向回的前端地址（默认本地面板）
# OAUTH_FRONTEND_URL=http://localhost:3001

# ── 注册面人机验证（Cloudflare Turnstile，可选；不配即关，配一半启动报错）────
# 生产暴露邮箱自助注册时必须配置：防分布式刷号薅首登赠额/跨受害者邮箱骚扰。
# Cloudflare Dashboard → Turnstile → Add site（域名填注册页所在域）拿 siteKey/secretKey。
# 本地开发可用官方测试键（恒过，widget 可见假盒子）：
#   CAPTCHA_SITE_KEY=1x00000000000000000000AA
#   CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# ── 邮箱自助注册开关（默认 true）────
# 关闭 = 只留 GitHub/Google OAuth 建号（身份锚点外包给平台方，防多账号薅赠额的最省力
# 路线）；存量邮箱账号登录不受影响（关注册 ≠ 关登录）。赠额套利压力大时随时切换。
# REGISTER_ENABLED=true

# ── uncertain 时效自动放行（R11-B：给预占加时间上界；无默认值，不配即关）────
# 双参数必须同时配置：滞留超过 HOURS 且预扣 ≤ MAX_AMOUNT 的 uncertain 单，
# 由系统自动「确认不收费」（actor=system，幂等+审计）；超过金额上限的留人工。
# 示例：滞留 24 小时且预扣 ≤ 5 元自动放行
# WORKER_UNCERTAIN_TIMEOUT_HOURS=24
# WORKER_UNCERTAIN_TIMEOUT_MAX_AMOUNT=5

WORKER_RETRY_BASE_MS=2000
WORKER_RETRY_MAX_MS=300000
WORKER_MAX_SETTLEMENT_ATTEMPTS=10
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_LOOP_STALE_MS=30000
WORKER_RECONCILE_INTERVAL_MS=3600000
# ── 观测（可选，compose 需 --profile obs 起观测栈）──
# ── 链路追踪 ────────────────────────────────────────────────────────────────
# off=关闭；memory=进程内缓冲+网关 /debug/traces（本地零基建，开发默认）；
# console=每次 span 一行日志；otlp=导出接收端（生产默认，compose 已指向 trace-receiver:8793）
# OTEL_TRACES_MODE=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8793
# trace-receiver 令牌（生产必填；本地开发内网可不设）
# ── 管理员邮箱验证码二次登录（第八轮；不配 = 功能不可用，登录保持单密码） ──
# 登录验证码发信（admin 2FA + client-api 强制邮箱验证共用；未配置 → C 端登录 503 fail-closed）
# 个人邮箱即可：QQ/163 邮箱设置里开启 SMTP 服务并生成「授权码」（不是邮箱密码）
# 例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=xxx@qq.com SMTP_PASS=授权码
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=你的SMTP授权码
# SMTP_FROM=
# TRACE_RECEIVER_TOKEN=change-me-trace-token-32chars
# trace_spans 分区保留天数（worker 定时清理）
# TRACE_RETENTION_DAYS=7
# ── 仅本地压测/调试用，生产勿设 ──
# 允许 http:// 与内网上游（双重门控：本开关为 true 且 NODE_ENV !== 'production' 才生效）
ALLOW_LOCAL_UPSTREAM=false
UPSTREAM_HOST_ALLOWLIST=api.openai.com,api.deepseek.com,api.minimax.chat,api.minimaxi.com,open.bigmodel.cn,api.anthropic.com,generativelanguage.googleapis.com
# 全局 RPM 上限（不设则默认 2000；生产环境强制硬上限 5000）
GLOBAL_RPM=2000
# ── client-api：新用户注册赠送额度（元，默认 ¥1）──
GIFT_AMOUNT=1
# ── 观测栈（compose --profile obs）──
# Grafana 管理员初始密码（默认 changeme）
GRAFANA_ADMIN_PASSWORD=changeme