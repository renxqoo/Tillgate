# ──────────────────────────────────────────────────────────────
# 环境变量模板
# 用法：cp .env.example .env，然后填写真实值
# ──────────────────────────────────────────────────────────────

# ── 运行环境 ──
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ──
# 格式：postgres://用户:密码@主机:端口/库名
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_gateway

# ── Redis ──
# REDIS_PASSWORD 用于 compose 的 redis --requirepass；REDIS_URL 须与此一致。
# 开发留空（compose 不启用 requirepass）；生产务必设强随机值。
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── 安全密钥（必填！留空或填占位符会启动失败）──
#
# 这两个密钥是系统安全的根基，必须用强随机值生成：
#   openssl rand -hex 32
#
# ⚠️ ENCRYPTION_KEY 特别注意：
#   - 用于加密 DB 中所有渠道的上游 API Key（AES-256-GCM）
#   - 一旦设定，不可随意更改——换了之后所有渠道密文无法解密
#   - 轮换需先跑 scripts/rotate-encryption-key.ts 重新加密所有渠道
#   - 禁止使用 change-me / secret / password 等弱值（config 会拒绝启动）
#
# ⚠️ JWT_SECRET：
#   - 用于签发登录会话 Token（HS256）
#   - 换了之后所有已登录用户需重新登录（无数据损失）
#   - 禁止使用弱值（config 会拒绝启动）
JWT_SECRET=
ENCRYPTION_KEY=

# ── 预扣计费参数（厘，1 元 = 1000 厘）──
HOLD_MAX=50000
HOLD_TTL_SECONDS=600

# ── 新用户默认限流 ──
DEFAULT_USER_RPM=60
DEFAULT_USER_TPM=1000000

# ── worker 计量结算并发数 ──
WORKER_CONCURRENCY=10

# ── 观测（可选，compose 需 --profile obs 起观测栈）──
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── 供应商上游凭据（生产按需填写，勿提交真实 Key）──
# MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 仅本地压测/调试用，生产勿设 ──
# 允许 http:// 与内网上游（双重门控：本开关为 true 且 NODE_ENV !== 'production' 才生效）
ALLOW_LOCAL_UPSTREAM=false
# 全局 RPM 上限覆盖（不设则默认 2000）
# GLOBAL_RPM=
