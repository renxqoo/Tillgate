# ── 环境变量模板（复制为 .env 并填写）──

# 运行环境
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_gateway

# Redis
REDIS_URL=redis://localhost:6379

# 安全（必填，生产环境用强随机值）
# openssl rand -hex 32
JWT_SECRET=change-me-32-chars-minimum-secret
ENCRYPTION_KEY=change-me-32-chars-minimum-secret

# 预扣参数（厘）
HOLD_MAX=50000
HOLD_TTL_SECONDS=600

# 新用户默认限流
DEFAULT_USER_RPM=60
DEFAULT_USER_TPM=1000000

# worker
WORKER_CONCURRENCY=10

# 观测（可选，compose 需 --profile obs 起观测栈）
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
