# ──────────────────────────────────────────────────────────────
# 环境变量模板
# 用法：cp .env.example .env，然后填写真实值
# ──────────────────────────────────────────────────────────────

# ── 运行环境 ──
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ──
# 格式：postgres://用户:密码@主机:端口/库名
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_gateway

# ── Redis ──
# REDIS_PASSWORD 用于 compose 的 redis --requirepass；REDIS_URL 须与此一致。
# 开发留空（compose 不启用 requirepass）；生产务必设强随机值。
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── 安全密钥（必填！留空或填占位符会启动失败）──
#
# 这两个密钥是系统安全的根基，必须用强随机值生成：
#   openssl rand -hex 32
#
# ⚠️ ENCRYPTION_KEY 特别注意：
#   - 用于加密 DB 中所有渠道的上游 API Key（AES-256-GCM）
#   - 一旦设定，不可随意更改——换了之后所有渠道密文无法解密
#   - 轮换需先跑 scripts/rotate-encryption-key.ts 重新加密所有渠道（pnpm --filter @ai-gateway/db exec tsx ../../scripts/rotate-encryption-key.ts）
#   - 禁止使用 change-me / secret / password 等弱值（config 会拒绝启动）
#
# ⚠️ JWT_SECRET（用户面会话密钥，client-api 用）：
#   - 签发用户登录会话 Token（ag_session cookie，HS256，type='user'）
#   - 换了之后所有已登录用户需重新登录（无数据损失）
#   - 禁止使用弱值（config 会拒绝启动）
JWT_SECRET=
#
# ⚠️ ADMIN_JWT_SECRET（管理面会话密钥，admin-api 用，与 JWT_SECRET 物理隔离）：
#   - 签发管理员登录会话 Token（ag_admin_session cookie，HS256，type='admin'）
#   - 必须与 JWT_SECRET 不同值（隔离要求：用户面 bug 不波及管理员）
#   - 换了之后所有管理员需重新登录
#   - 禁止使用弱值（config 会拒绝启动）
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=

# ── 渠道进货凭证截图存储（本地磁盘，后续可切 OSS） ──
VOUCHER_STORAGE_DIR=./data/vouchers
VOUCHER_MAX_BYTES=2097152

# ── 企业计费授权与 lease ──
BILLING_RESERVATION_MAX=50
BILLING_PENDING_MAX=10000
BILLING_PENDING_MAX_AGE_SECONDS=300
BILLING_ADMISSION_CACHE_MS=1000
BILLING_AUTHORIZATION_TTL_SECONDS=60
BILLING_LEASE_SECONDS=60
GATEWAY_REQUEST_DEADLINE_MS=240000
GATEWAY_MAX_CONNECTIONS=10000
GATEWAY_HEADERS_TIMEOUT_MS=10000
GATEWAY_REQUEST_TIMEOUT_MS=300000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 新用户默认限流 ──
DEFAULT_USER_RPM=60
DEFAULT_USER_TPM=1000000

# ── worker 计量结算并发数 ──
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=8792
WORKER_CLAIM_BATCH_SIZE=100
WORKER_CLAIM_LEASE_MS=60000
WORKER_POLL_INTERVAL_MS=2000
WORKER_RECOVERY_INTERVAL_MS=30000
WORKER_RECOVERY_BATCH_SIZE=500
WORKER_RETRY_BASE_MS=2000
WORKER_RETRY_MAX_MS=300000
WORKER_MAX_SETTLEMENT_ATTEMPTS=10
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_LOOP_STALE_MS=30000
WORKER_RECONCILE_INTERVAL_MS=3600000

# ── 观测（可选，compose 需 --profile obs 起观测栈）──
# ── 链路追踪 ────────────────────────────────────────────────────────────────
# off=关闭；memory=进程内缓冲+网关 /debug/traces（本地零基建，开发默认）；
# console=每次 span 一行日志；otlp=导出接收端（生产默认，compose 已指向 trace-receiver:8793）
# OTEL_TRACES_MODE=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8793
# trace-receiver 令牌（生产必填；本地开发内网可不设）
# TRACE_RECEIVER_TOKEN=change-me-trace-token-32chars
# trace_spans 分区保留天数（worker 定时清理）
# TRACE_RETENTION_DAYS=7

# ── 供应商上游凭据（生产按需填写，勿提交真实 Key）──
# MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 仅本地压测/调试用，生产勿设 ──
# 允许 http:// 与内网上游（双重门控：本开关为 true 且 NODE_ENV !== 'production' 才生效）
ALLOW_LOCAL_UPSTREAM=false
UPSTREAM_HOST_ALLOWLIST=api.openai.com,api.deepseek.com,api.minimax.chat,api.minimaxi.com,open.bigmodel.cn,api.anthropic.com,generativelanguage.googleapis.com
# 全局 RPM 上限（不设则默认 2000；生产环境强制硬上限 5000）
GLOBAL_RPM=2000

# ── client-api：新用户注册赠送额度（元，默认 ¥1）──
GIFT_AMOUNT=1

# ── 观测栈（compose --profile obs）──
# Grafana 管理员初始密码（默认 changeme）
GRAFANA_ADMIN_PASSWORD=changeme
