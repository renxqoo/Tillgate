# ══════════════════════════════════════════════════════════════════════════
# Tillgate 必填配置——只列「不配置无法启动」的键。
# 其余全部配置项（阈值/节奏/开关/端口等）有代码最优默认值，按需覆盖：
# 逐键说明与默认值见 docs/configuration.md
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_gateway
# ── Redis ──
# 本地开发（compose.dev 起的无密码实例）：
REDIS_URL=redis://localhost:6379
# 生产建议（带密码直连；compose 部署时设 REDIS_PASSWORD 后此键由 compose 自动注入）：
# REDIS_URL=redis://:强随机密码@redis:6379
# REDIS_PASSWORD=强随机密码          # compose 用它建 Redis 密码
# 高可用建议（Sentinel 拓扑，见 docs/ha-deployment.md；配置后覆盖直连形态）：
# REDIS_SENTINELS=host1:26379,host2:26379,host3:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=强随机密码
# 故障韧性：Redis 不可用时网关推理零影响；登录走本地粗限；结算不受影响（PG NOTIFY）——详见 docs

# 密钥（生产必须全部换强随机值；弱值启动即拒绝）
JWT_SECRET=                             # ≥32 随机（用户面会话 + 网关 App JWT）
ADMIN_JWT_SECRET=                       # ≥32 随机（管理面独立，勿与上者相同）
ENCRYPTION_KEY=                         # ≥32 随机（渠道上游 Key 落库加密；轮换走双 key 窗）
IDENTITY_CODE_PEPPER=                   # ≥16 随机（identity 挑战/恢复码 HMAC pepper；admin-api 装配必填）
CLIENT_CODE_PEPPER=                     # ≥16 随机（client-api 用户面验证码 HMAC pepper；与管理面 pepper 分离）

# 管理控制面（apps/admin-api；缺省 8082，其余旋钮见 docs/configuration.md）
# ADMIN_API_PORT=8082
# SESSION_TTL_SECONDS=86400
# KEY_PREFIX=sk_                         # 三个 API 进程必须同值；存量部署切换需重发全部 Key
# ADMIN_WEBHOOK_ALLOW_LOCAL_URL=false      # 通知渠道 webhook 本地地址逃生门（P5；与 worker 同语义）

# 链路接收鉴权（生产强制；生成：openssl rand -hex 24）——trace-receiver 与三个推流 app
# （gateway/client-api/admin-api 的 initOtel authToken）共用此键自动对齐；缺此值时生产
# 接收端对全部 OTLP 推送回 401。注意 docker/compose.yml 各服务 environment 的
# OTEL_TRACES_MODE 缺省为 'off'（覆盖 env_file）——启用链路需同步改 compose 或去掉覆盖。
# TRACE_RECEIVER_TOKEN=

# ── 后台任务应用（apps/worker）──
# 必填同上 DATABASE_URL；渠道 Key 解密专用键（worker 必配此键，无 ENCRYPTION_KEY 回退——
# 仅 gateway 侧支持此键缺省时回落 ENCRYPTION_KEY）：
# CHANNEL_API_KEY_ENCRYPTION=             # ≥32 随机
# 节奏/批量/租约全套有部署默认值（30s 结算扫描 / 15s 恢复 / 5s 生成轮询 / 1h 佣金·对账·分区），
# 逐键说明与默认值见 apps/worker/src/config.ts（zod schema 是唯一真相）：
# WORKER_OWNER_ID=                        # 认领归属（缺省 worker-{pid}；多副本建议显式命名）
# WORKER_SETTLE_WAKE=true                 # PG LISTEN settle-wake 低延迟唤醒（生产端=gateway pg_notify）
# WORKER_NOTIFY_ENABLED=true              # 告警投递静音开关（本地开发可 false）
# WORKER_BALANCE_LOW_THRESHOLD=5          # balance_low 预警阈值（元）
# WORKER_HEALTH_PORT=8792                 # /livez /readyz /health（0=关闭；/health 需 x-health-token）
# WORKER_HEALTH_TOKEN=                    # 空 = /health 恒 403（深度报告需令牌）
# WORKER_SHUTDOWN_GRACE_MS=15000
# 第三方集成（OAuth/SMTP/Turnstile/易支付/Stripe）凭据已迁 integration_settings 动态配置
# （admin 端 /dashboard/settings 管理；存量 env 迁移：bun run integrations:import）

# ── Docker compose 部署（docker/compose.yml；本节键仅 compose 插值消费，应用不读）──
# POSTGRES_USER=postgres                # 容器 PG 超级用户（缺省 postgres）
# POSTGRES_PASSWORD=postgres            # 容器 PG 密码（生产必改强随机；compose 同时用它拼 DATABASE_URL）
# POSTGRES_DB=ai_gateway                # 库名（缺省 ai_gateway，与本地开发一致）
# TILLGATE_TAG=local                   # 自建镜像标签（compose build 产物 tillgate/<svc>:<tag>）
# GRAFANA_ADMIN_PASSWORD=强随机密码      # obs profile 必配（未设时 compose 直接拒绝启动）
