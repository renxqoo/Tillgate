{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "max-lines": ["error", { "max": 500 }],
    "eslint/no-nested-ternary": "error"
  },
  "overrides": [
    {
      "files": ["**/__test__/**", "**/*.test.ts", "**/*.spec.ts", "**/testing/**"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/*.generated.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/migrations/**",
    "**/components/ui/**"
  ]
}
