{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "trailingComma": "all",
  "ignorePatterns": [
    "docs/**",
    "**/dist/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/migrations/**"
  ]
}
