{
  "name": "@tillgate/notifications",
  "version": "0.1.0",
  "private": true,
  "description": "通知能力:渠道 CRUD、事务 outbox 入箱/认领/投递与告警模板(总纲 §3/P4.1)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "development": "./src/composition.ts",
      "types": "./src/composition.ts",
      "import": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/composition.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x --bun vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x --bun vitest run __test__/postgres.real.test.ts --passWithNoTests",
    "test:coverage": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@tillgate/db": "workspace:*",
    "@tillgate/errors": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
