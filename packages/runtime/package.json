{
  "name": "@tokenlens/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "仅服务端运行时基础设施：配置校验、日志、加密、Redis、进程生命周期（重构方案 §3.1；禁止业务规则/业务 SQL/HTTP route）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/testing/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x vitest run --passWithNoTests",
    "test:watch": "bun x vitest",
    "test:coverage": "bun x vitest run --coverage"
  },
  "dependencies": {
    "ioredis": "^5.8.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
