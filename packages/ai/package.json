{
  "name": "@ai-gateway/ai",
  "version": "0.1.0",
  "private": true,
  "description": "上游 LLM 传输层（自研）：可靠调用上游大模型并产出结构化事件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/real --passWithNoTests",
    "test:real": "vitest run test/real --passWithNoTests",
    "test:watch": "vitest --exclude test/real",
    "lint": "oxlint"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
