{
  "name": "@tillgate/ai",
  "version": "0.1.0",
  "private": true,
  "description": "上游协议库：透传中继 + 多协议适配 + 多模态 + 事件观察面（§3.6 数据面/观察面契约，零运维状态）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x --bun vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x --bun vitest run -c vitest.real.config.ts",
    "test:coverage": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
