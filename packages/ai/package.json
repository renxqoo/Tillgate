{
  "name": "@ai-gateway/ai",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "上游 LLM 传输层（自研）：可靠调用上游大模型并产出结构化事件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun x vitest run --exclude test/real --passWithNoTests",
    "test:real": "bun x vitest run test/real --passWithNoTests",
    "test:watch": "bun x vitest --exclude test/real",
    "lint": "bun x oxlint",
    "test:coverage": "bun x vitest run --coverage",
    "model-meta": "bun scripts/generate-model-meta.mts"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
