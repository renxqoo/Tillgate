{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // 铁律 9：子包只做文件级覆盖，规则集一律继承根配置
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    // vendored shadcn 组件：不改不动，整体跳过（正确性由上游负责）
    "src/components/navigation/sidebar.tsx",
    "src/components/forms/calendar.tsx",
    "src/components/forms/slider.tsx",
    "src/components/data/chart.tsx"
  ],
  "overrides": [
    {
      // 设计系统原语族是 shadcn 形态（一文件一族小包装组件），
      // 豁免根配置的一文件一组件规则；glob 相对本包目录解析
      "files": ["src/components/**"],
      "rules": {
        "tillgate/no-multi-component": "off"
      }
    }
  ]
}
