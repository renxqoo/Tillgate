{
  "name": "@tokenlens/billing",
  "version": "0.1.0",
  "private": true,
  "description": "唯一资金与计费事实源：金额/钱包/账本/计价/订阅/支付/兑换/结算与恢复（ADR-0003、DESIGN.md、IMPLEMENTATION.md）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "development": "./src/composition.ts",
      "types": "./src/composition.ts",
      "import": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/composition.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x vitest run __test__/wallet-contract.real.test.ts __test__/wallet-invariants.real.test.ts __test__/settlement-lifecycle.real.test.ts --passWithNoTests",
    "test:coverage": "bun x vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@tokenlens/db": "workspace:*",
    "@tokenlens/errors": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
