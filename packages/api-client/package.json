{
  "name": "@tillgate/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "client-api/admin-api 调用封装:框架无关 transport/错误/分页 + 手写 DTO 快照 + ./next BFF 装配子入口(发布候选第一候选,总纲 §3/§7.2)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "development": "./src/next/index.ts",
      "types": "./src/next/index.ts",
      "import": "./dist/next/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/next/index.ts --target=bun --format=esm --sourcemap --packages=external --splitting --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --passWithNoTests",
    "test:watch": "bun x --bun vitest",
    "test:coverage": "bun x --bun vitest run --coverage",
    "generate:dto": "bun scripts/generate-dto.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "^16.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "next": "^16.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
