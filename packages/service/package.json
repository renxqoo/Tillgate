{
  "name": "@ai-gateway/service",
  "version": "0.1.0",
  "private": true,
  "description": "用例层独立包：全部业务用例与事务编排（wallet 八动词 / billing 授权预扣与信号 / channel-budget 收尾 / 幂等操作）——依赖 domain 与 repository，零 HTTP 零 SQL",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-gateway/domain": "workspace:*",
    "@ai-gateway/repository": "workspace:*"
  },
  "devDependencies": {
    "@ai-gateway/db": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
