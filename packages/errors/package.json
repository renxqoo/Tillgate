{
  "name": "@tillgate/errors",
  "version": "0.1.0",
  "private": true,
  "description": "内部错误根契约：三性根类 + category 闭集 + 命名空间错误目录契约 + 规范化错误记录——零业务/协议依赖的稳定叶子（ADR-0001）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --passWithNoTests",
    "test:watch": "bun x --bun vitest",
    "test:coverage": "bun x --bun vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
