{
  "name": "@ai-gateway/ledger",
  "version": "0.1.0",
  "private": true,
  "description": "资金账本领域（gateway 与 worker 共用）：请求级预扣生命周期 + 计量结算 + 对账，DB 单事实来源",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rating": {
      "development": "./src/rating/index.ts",
      "types": "./dist/rating.d.ts",
      "import": "./dist/rating.js"
    },
    "./subscription": {
      "development": "./src/subscription/index.ts",
      "types": "./dist/subscription.d.ts",
      "import": "./dist/subscription.js"
    },
    "./channel-budget": {
      "development": "./src/channel-budget/index.ts",
      "types": "./dist/channel-budget.d.ts",
      "import": "./dist/channel-budget.js"
    },
    "./billing": {
      "development": "./src/billing/domain.ts",
      "types": "./dist/billing.d.ts",
      "import": "./dist/billing.js"
    },
    "./settlement": {
      "development": "./src/settlement/index.ts",
      "types": "./dist/settlement.d.ts",
      "import": "./dist/settlement.js"
    },
    "./platform": {
      "development": "./src/platform/index.ts",
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/ledger-core": "workspace:*",
    "@ai-gateway/wallet": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@ai-gateway/http": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
