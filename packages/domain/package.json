{
  "name": "@ai-gateway/domain",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "领域规则层独立包：全部业务纯函数（金额值对象/过账规则/账户守卫/计价公式/状态机/限额窗口）——零 SQL、零 DB、零框架，仅 decimal.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
