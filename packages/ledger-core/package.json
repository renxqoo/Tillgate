{
  "name": "@ai-gateway/ledger-core",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "通用幂等资金操作内核（业务无关）：operationId 唯一 + canonical 指纹 + 回执重放——业务状态机与钱包动词同事务的安全编排层，可与 @ai-gateway/wallet 组合，也可独立承载纯业务幂等",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/migrate-cli.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x vitest run",
    "provision": "node ./dist/migrate-cli.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
