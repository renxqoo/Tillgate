{
  "name": "@tillgate/accounts",
  "version": "0.1.0",
  "private": true,
  "description": "账号能力:用户资料、组织/成员/邀请、API Key、Application、推荐与拉新参数——账号事实唯一所有者,不保存认证秘密(DESIGN.md、MIGRATION.md)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "development": "./src/composition.ts",
      "types": "./src/composition.ts",
      "import": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/composition.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x oxlint",
    "test": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --passWithNoTests",
    "test:watch": "bun x --bun vitest --exclude \"__test__/*.real.test.ts\"",
    "test:real": "bun x --bun vitest run __test__/postgres-store.real.test.ts --passWithNoTests",
    "test:coverage": "bun x --bun vitest run --exclude \"__test__/*.real.test.ts\" --coverage"
  },
  "dependencies": {
    "@tillgate/db": "workspace:*",
    "@tillgate/errors": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
