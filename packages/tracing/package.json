{
  "name": "@ai-gateway/tracing",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "链路追踪领域（receiver/admin-api/worker 共用）：OTLP JSON 解码 + span 存储（PG 日分区）+ 分区维护",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./graph": {
      "development": "./src/graph.ts",
      "types": "./src/graph.ts",
      "import": "./dist/graph.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/graph.ts --target=bun --format=esm --sourcemap --packages=external --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun x vitest run --passWithNoTests",
    "lint": "bun x oxlint"
  },
  "dependencies": {
    "@ai-gateway/db": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
